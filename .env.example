# ==========================================
# Shopify Collections Exporter - Environment Variables
# ==========================================

# 1. Database Connection (PostgreSQL on Render or local PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# 2. Shopify App Store / Embedded App Credentials
NEXT_PUBLIC_SHOPIFY_API_KEY="your-shopify-client-id-api-key"
SHOPIFY_API_SECRET="your-shopify-client-secret"
SCOPES="read_products,write_products"
HOST="https://collections-exporter.onrender.com"
ENCRYPTION_KEY="your-random-32-byte-hex-encryption-key"

# 3. Development / Legacy Login Flag
# Set to "true" during local development to keep credentials login active on test scripts.
# Defaults to "false" in production (Shopify App Store).
ENABLE_LEGACY_LOGIN="false"

# 4. Administrator Credentials for /admin Dashboard
AUTH_SECRET="collections-exporter-secret-key-super-secure-2026-shopify-session"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin12345"
ADMIN_DISPLAY_NAME="System Administrator"

# 5. App UI
NEXT_PUBLIC_APP_NAME="Collections Exporter"
