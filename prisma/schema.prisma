generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Shop {
  id            String    @id @default(uuid())
  shop          String    @unique
  accessToken   String
  scope         String?
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
}

model ShopLink {
  id              String   @id @default(uuid())
  sourceShop      String
  destinationShop String
  createdAt       DateTime @default(now())

  @@unique([sourceShop, destinationShop])
}

model OAuthState {
  id          String   @id @default(uuid())
  state       String   @unique
  shop        String   // source shop
  destination String   // destination shop
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model User {
  id                  String        @id @default(uuid())
  displayName         String
  username            String        @unique
  passwordHash        String
  role                String        @default("user") // "user" | "admin"
  status              String        @default("active") // "active" | "disabled"
  failedLoginAttempts Int           @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime      @default(now())
  lastLoginAt         DateTime?
  activityLogs        ActivityLog[]
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  username  String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Collection {
  id              String   @id @default(uuid())
  shop            String
  shopifyId       String?
  title           String
  handle          String
  type            String   // "smart" or "custom"
  descriptionHtml String?  @db.Text
  sortOrder       String?  @default("best-selling")
  rules           Json?    // Array of rule conditions
  disjunctive     Boolean  @default(false)
  productCount    Int      @default(0)
  imageUrl        String?  @db.Text
  imageAlt        String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([shop, handle])
  @@index([shop])
}

model ExportHistory {
  id               String   @id @default(uuid())
  shop             String
  fileName         String
  totalCollections Int      @default(0)
  fileSize         Int?
  exportedBy       String?
  createdAt        DateTime @default(now())

  @@index([shop])
}

model ImportHistory {
  id           String       @id @default(uuid())
  shop         String
  fileName     String
  totalRows    Int          @default(0)
  successCount Int          @default(0)
  errorCount   Int          @default(0)
  status       String       @default("COMPLETED")
  importedBy   String?
  createdAt    DateTime     @default(now())
  items        ImportItem[]

  @@index([shop])
}

model ImportItem {
  id           String        @id @default(uuid())
  importJobId  String
  handle       String
  title        String
  status       String        // "SUCCESS" | "FAILED" | "SKIPPED"
  errorMessage String?       @db.Text
  createdAt    DateTime      @default(now())
  importJob    ImportHistory @relation(fields: [importJobId], references: [id], onDelete: Cascade)

  @@index([importJobId])
}

model SupportConversation {
  id                  String              @id @default(uuid())
  shop                String
  customerEmail       String
  customerName        String?
  customerPhone       String?
  supportType         String              @default("chat") // "chat" | "call"
  callRequested       Boolean             @default(false)
  callTopic           String?
  callPreferredTime   String?
  humanRequested      Boolean             @default(false)
  status              String              @default("Pending") // "Pending" | "In Progress" | "Resolved" | "Closed"
  lastMessage         String?
  lastMessageAt       DateTime            @default(now())
  unreadAdminCount    Int                 @default(0)
  unreadCustomerCount Int                 @default(0)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  messages            SupportMessage[]
  attachments         SupportAttachment[]

  @@index([shop])
  @@index([status])
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String              // "customer" | "admin" | "bot" | "system"
  senderName     String?
  messageType    String              @default("text") // "text" | "audio" | "image" | "video" | "file" | "system"
  content        String?             @db.Text
  fileUrl        String?             @db.Text
  fileName       String?
  fileSize       Int?
  fileMime       String?
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}

model SupportAttachment {
  id             String              @id @default(uuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  fileUrl        String              @db.Text
  fileName       String
  fileSize       Int
  fileMime       String
  filePath       String
  createdAt      DateTime            @default(now())

  @@index([conversationId])
}
